{
  "name": "@bifravst/aws-ssm-settings-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions written in TypeScript for storing and retrieving application settings in AWS SSM Parameter Store.",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/settings.d.ts",
        "default": "./dist/settings.js"
      }
    },
    "./cdk": {
      "import": {
        "types": "./dist/cdk/index.d.ts",
        "default": "./dist/cdk/index.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test": "node --experimental-transform-types --no-warnings --test ./src/*.spec.ts",
    "prepublishOnly": "npx tsc --noEmit false --outDir ./dist -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/aws-ssm-settings-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/aws-ssm-settings-helpers/issues"
  },
  "homepage": "https://github.com/bifravst/aws-ssm-settings-helpers",
  "keywords": [
    "aws",
    "ssm",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.2",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk-lib": "2.265.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "peerDependencies": {
    "@aws-sdk/client-ssm": "^3.1111.0"
  }
}
